   "source": [
    "import cv2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "39f47f45",
   "metadata": {},
   "outputs": [],
   "source": [
    "video=cv2.VideoCapture(1)\n",
    "while True:\n",
    "    result,frame=video.read()\n",
    "    if not result:\n",
    "        break\n",
    "    cv2.imshow(\"video\",frame[100:500,100:500])\n",
    "    if cv2.waitKey(1) & 0xFF==ord(\"q\"):\n",
    "        break\n",
    "\n",
    "video.release()\n",
    "cv2.destroyAllWindows()"
   ]
  }
