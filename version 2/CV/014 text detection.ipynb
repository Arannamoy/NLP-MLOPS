    "video=cv2.VideoCapture(2)\n",
    "while True:\n",
    "    success,frame=video.read()\n",
    "    if not success:\n",
    "        break\n",
    "    cv2.imshow(\"video\",frame)\n",
    "    if cv2.waitKey(1) & 0xFF==ord('q'):\n",
    "        break\n",
    "\n",
    "video.release()\n",
    "cv2.destroyAllWindows()\n"
   ]
